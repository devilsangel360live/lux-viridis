# Copy to .env on the OMV box and fill in.
#   cp .env.example .env

# Where the SQLite database lives on the host. Point this at your OMV pool so
# the data survives container rebuilds and lands on redundant storage.
#   LUX_DATA_DIR=/srv/dev-disk-by-uuid-XXXX/appdata/lux/data
LUX_DATA_DIR=./data

# Nightly database snapshots. Keep this on the pool too — a backup on the same
# disk as the original protects against mistakes, not disk failure.
#   LUX_BACKUP_DIR=/srv/dev-disk-by-uuid-XXXX/appdata/lux/backups
LUX_BACKUP_DIR=./backups

# Cloudflare Tunnel token, from
#   Zero Trust dashboard -> Networks -> Tunnels -> Create -> Docker
# The panel shows a `cloudflared ... run --token <TOKEN>` command; paste only
# the token here. Treat it as a secret: it grants access to route traffic.
CLOUDFLARE_TUNNEL_TOKEN=
